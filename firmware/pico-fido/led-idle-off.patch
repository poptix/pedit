+/* pedit local patch: the idle/standby modes are silenced so the LED is dark
+ * unless the device is actually doing something. Stock upstream values are
+ * kept in comments below -- restore them to get the original behaviour.
+ *
+ * Only the three "nothing is happening" states are changed. MODE_PROCESSING
+ * (an APDU is being handled) and MODE_BUTTON (waiting for your touch) are
+ * left alone, as are the explicit led_blink_n_times() success blinks, which
+ * bypass these modes entirely.
+ *
+ * On an always-plugged-in board the practical effect is killing the slow
+ * blue MODE_SUSPENDED flash, which is what a USB-suspended idle key shows.
+ */
 enum  {
-    MODE_NOT_MOUNTED = (MAX_BTNESS << LED_BTNESS_SHIFT) | (LED_COLOR_RED << LED_COLOR_SHIFT) | (500 << LED_ON_SHIFT) | (500 << LED_OFF_SHIFT),
